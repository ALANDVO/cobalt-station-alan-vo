# VoiceStudio Configuration
# Copy to .env and fill in values

# Application
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
DEBUG=true

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./voicestudio.db

# TTS Settings
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cpu
TTS_CACHE_DIR=./models/tts

# LLM (optional, for future features)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=
LLM_BASE_URL=

# Keycloak / OIDC (for auth phase)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=voicestudio
KEYCLOAK_CLIENT_ID=voicestudio-frontend
KEYCLOAK_CLIENT_SECRET=
OIDC_ISSUER=http://localhost:8080/realms/voicestudio

# Security
SECRET_KEY=change-me-in-production-use-secure-random-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=30